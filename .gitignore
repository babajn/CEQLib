# Reference papers stay local; only the index is tracked
/reference/*.pdf

# Bundle the seven spectra generated with PEGASE.2 and keep its program local
/data/PEGASE2/*
!/data/PEGASE2/spectra_Kroupa_Z0.0001.dat
!/data/PEGASE2/spectra_Kroupa_Z0.0004.dat
!/data/PEGASE2/spectra_Kroupa_Z0.0040.dat
!/data/PEGASE2/spectra_Kroupa_Z0.0080.dat
!/data/PEGASE2/spectra_Kroupa_Z0.0200.dat
!/data/PEGASE2/spectra_Kroupa_Z0.0500.dat
!/data/PEGASE2/spectra_Kroupa_Z0.1000.dat

# Local Le Bourlot et al. (1999) reference files
/data/LeBourlot+1999/interp.f
/data/LeBourlot+1999/le_cube.data

# Local ionization and recombination reference tables
/data/GnatSternberg2007/*.dat
/data/Nahar1999/*.dat
/data/NaharPradhan1997/*.dat

# Local Gnat & Ferland (2012) tables outside the CIE generator inputs
/data/GnatFerland2012/H.dat
/data/GnatFerland2012/He.dat

# Local gnuplot scripts
/plot/**/*.gp
